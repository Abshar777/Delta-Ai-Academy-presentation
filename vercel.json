{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(mp4|webm|png|jpg|jpeg|svg|woff2|pdf|pptx|srt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/keynote", "destination": "/presentation", "permanent": false },
    { "source": "/bold", "destination": "/delta-bold", "permanent": false },
    { "source": "/intro", "destination": "/presentation-intro-dark-oled", "permanent": false },
    { "source": "/intro-navy", "destination": "/presentation-intro-dark", "permanent": false }
  ]
}
